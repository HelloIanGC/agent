{
  "name": "spreadjs-mcp-system",
  "version": "1.0.0",
  "description": "SpreadJS MCP System with AI natural language interface",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:mcp\" \"npm run dev:frontend\"",
    "dev:mcp": "cd packages/mcp-server && npm run dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "build": "npm run build --workspaces",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react-resizable-panels": "^3.0.3"
  }
}
